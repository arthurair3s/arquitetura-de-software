@startuml C4_L3_Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Componentes (L3) - Backend Core (API Node)

' -------------------------------------------------------------
' CONTAINERS EXTERNOS AO DIAGRAMA DE COMPONENTES
' -------------------------------------------------------------
Container(gateway, "API Gateway (Kong)", "Kong 3.4", "Encaminha requisições GraphQL autorizadas.")
ContainerDb(db_postgres, "Banco de Dados Principal", "PostgreSQL 15", "Armazena dados transacionais do sistema principal.")
ContainerDb(db_redis, "Cache (Redis)", "Redis 7", "Guarda cache-aside e posições geográficas em tempo real.")
Container(rabbitmq, "RabbitMQ", "RabbitMQ 3", "Broker de eventos assíncronos.")
Container(ms_entregadores, "Microserviço de Entregadores", "C# / gRPC", "Gerencia a frota de entregadores.")
Container(ms_roteamento, "Microserviço de Roteamento", "C# / gRPC", "Calcula rotas e caminhos.")
Container(ms_recomendacao, "Microserviço de Recomendação", "Python / gRPC", "Fornece insights analíticos de vendas.")

' -------------------------------------------------------------
' CAMADAS DO BACKEND CORE (API NODE)
' -------------------------------------------------------------
Container_Boundary(api_node, "Backend Core (API Node)") {

    ' 1. Camada de Apresentação
    Boundary(layer_presentation, "Camada de Apresentação") {
        Component(resolvers, "GraphQL Resolvers", "Apollo Resolvers (TS)", "Recebe as consultas/mutações e interage com os Use Cases e Serviços (ex: criarPedido, restaurantes).")
    }

    ' 2. Camada de Aplicação
    Boundary(layer_application, "Camada de Aplicação") {
        Component(confirmar_pedido_uc, "ConfirmarPedidoUseCase", "TypeScript Class", "Caso de uso para criar/confirmar um novo pedido e publicar o evento.")
        Component(atribuir_entregador_uc, "AtribuirEntregadorUseCase", "TypeScript Class", "Caso de uso para registrar a entrega atribuída a um entregador.")
        Component(assinar_recomendacao_uc, "AssinarPlanoRecomendacaoUseCase", "TypeScript Class", "Caso de uso para gerenciar assinaturas premium no MS Recomendação.")
        Component(povoar_frota_uc, "PovoarFrotaUseCase", "TypeScript Class", "Caso de uso para povoamento e simulação espacial de frotas de entregadores.")
        Component(atualizar_localizacao_entregador_uc, "AtualizarLocalizacaoEntregadorUseCase", "TypeScript Class", "Caso de uso para validar e atualizar a localização geo-espacial.")
        Component(obter_rota_estavel_uc, "ObterRotaEstavelUseCase", "TypeScript Class", "Caso de uso para obter rota estável da entrega.")
        Component(obter_rota_coleta_uc, "ObterRotaColetaUseCase", "TypeScript Class", "Caso de uso para obter rota de coleta.")
        Component(obter_rota_entrega_uc, "ObterRotaEntregaUseCase", "TypeScript Class", "Caso de uso para obter rota de entrega.")
        Component(obter_insights_uc, "ObterInsightsUseCase", "TypeScript Class", "Caso de uso para consultar insights analíticos via gRPC.")
        Component(processar_pagamento_uc, "ProcessarPagamentoUseCase", "TypeScript Class", "Caso de uso para gerenciar pagamentos seguros via Stripe.")
        Component(login_usuario_uc, "LoginUsuarioUseCase", "TypeScript Class", "Caso de uso para login e autenticação com JWT.")
        Component(app_services, "Serviços de Aplicação", "TypeScript Classes", "Implementam as portas de serviço secundárias ou genéricas (ex: UsuarioAppService).")
        Component(validators, "Validadores (Zod)", "Zod Schemas", "Validam as payloads de entrada do GraphQL.")
    }

    ' 3. Camada de Domínio
    Boundary(layer_domain, "Camada de Domínio (Core)") {
        Component(entities, "Entidades de Domínio", "TypeScript Classes", "Modelos ricos com lógica e invariantes de negócio (ex: Usuario, Pedido, Pagamento, Restaurante).")
        Component(value_objects, "Value Objects", "TypeScript Classes", "Objetos de valor imutáveis autovalidados (ex: Coordenada, Dinheiro, Email, StatusPedido).")
        Component(domain_ports, "Portas (Interfaces)", "TypeScript Interfaces", "Definem contratos de repositórios (ex: IPedidoRepository) e integrações (ex: IEventPublisher).")
    }

    ' 4. Camada de Infraestrutura
    Boundary(layer_infrastructure, "Camada de Infraestrutura") {
        Component(prisma_adapters, "Adaptores Prisma", "TypeScript Adapters", "Implementam as interfaces de repositórios do domínio conectando no Prisma Client.")
        Component(rabbitmq_publisher, "RabbitMQPublisher", "TypeScript Client", "Implementa a interface IEventPublisher para disparar eventos assíncronos.")
        Component(rabbitmq_consumer, "RabbitMQConsumer", "TypeScript Background Worker", "Consome eventos de filas (ex: entrega-atribuida) e orquestra Use Cases correspondentes.")
        Component(grpc_providers, "Provedores gRPC (Clients)", "TypeScript gRPC Clients", "Implementam portas gRPC de integração com microserviços externos.")
        Component(redis_client, "RedisClient Singleton", "ioredis", "Mantém a conexão Singleton e executa comandos de cache no Redis.")
        Component(token_service, "Serviço de Token (JWT)", "jsonwebtoken library", "Implementa ITokenService para autenticação.")
        Component(opentelemetry_sdk, "OpenTelemetry SDK", "TypeScript Config", "Inicializa o tracing distribuído e a instrumentação automática do Node.js/GraphQL.")
    }
}

' -------------------------------------------------------------
' RELACIONAMENTOS / DEPENDÊNCIAS
' -------------------------------------------------------------

' Entrada
Rel(gateway, resolvers, "Encaminha consultas GraphQL", "HTTP / POST /graphql")

' Apresentação -> Aplicação
Rel(resolvers, validators, "Valida inputs de entrada", "SafeParse")
Rel(resolvers, confirmar_pedido_uc, "Invoca caso de uso de pedido", "execute()")
Rel(resolvers, atribuir_entregador_uc, "Invoca caso de uso de atribuir entregador", "execute()")
Rel(resolvers, assinar_recomendacao_uc, "Invoca caso de uso de assinatura", "execute()")
Rel(resolvers, povoar_frota_uc, "Invoca caso de uso de povoar frota", "execute()")
Rel(resolvers, atualizar_localizacao_entregador_uc, "Invoca caso de uso de atualizar localização", "execute()")
Rel(resolvers, obter_rota_estavel_uc, "Invoca caso de uso de rota estável", "execute()")
Rel(resolvers, obter_rota_coleta_uc, "Invoca caso de uso de rota coleta", "execute()")
Rel(resolvers, obter_rota_entrega_uc, "Invoca caso de uso de rota entrega", "execute()")
Rel(resolvers, obter_insights_uc, "Invoca caso de uso de insights", "execute()")
Rel(resolvers, processar_pagamento_uc, "Invoca caso de uso de pagamento", "execute()")
Rel(resolvers, login_usuario_uc, "Invoca caso de uso de login", "execute()")
Rel(resolvers, app_services, "Chama serviços auxiliares", "Method calls")

' Aplicação -> Domínio
Rel(confirmar_pedido_uc, entities, "Manipula entidades", "Domain Logic")
Rel(confirmar_pedido_uc, value_objects, "Instancia objetos", "Value Objects")
Rel(atribuir_entregador_uc, entities, "Manipula entidades", "Domain Logic")
Rel(povoar_frota_uc, entities, "Manipula entidades", "Domain Logic")
Rel(atualizar_localizacao_entregador_uc, entities, "Valida/Manipula entidades", "Domain Logic")
Rel(app_services, entities, "Manipula entidades", "Domain Logic")

' Abstração e Inversão de Dependência (Aplicação -> Portas)
Rel(confirmar_pedido_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(atribuir_entregador_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(assinar_recomendacao_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(povoar_frota_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(atualizar_localizacao_entregador_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(obter_rota_estavel_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(obter_rota_coleta_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(obter_rota_entrega_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(obter_insights_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(processar_pagamento_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(login_usuario_uc, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")
Rel(app_services, domain_ports, "Usa abstrações (Inversão de Dependência)", "Interfaces")

' Implementações da Infraestrutura
Rel(prisma_adapters, domain_ports, "Implementa contratos de persistência", "Implements")
Rel(rabbitmq_publisher, domain_ports, "Implementa IEventPublisher", "Implements")
Rel(grpc_providers, domain_ports, "Implementa contratos gRPC", "Implements")
Rel(token_service, domain_ports, "Implementa ITokenService", "Implements")

' Background Event Consumer
Rel(rabbitmq_consumer, rabbitmq, "Consome eventos (entrega-atribuida)", "AMQP (Port 5672)")
Rel(rabbitmq_consumer, atribuir_entregador_uc, "Invoca caso de uso de atribuição", "execute()")

' Instrumentação / Observabilidade
Rel(opentelemetry_sdk, resolvers, "Intercepta execuções de queries/mutations", "Automatic hook")
Rel(opentelemetry_sdk, prisma_adapters, "Mede performance das queries SQL", "Automatic hook")
Rel(opentelemetry_sdk, grpc_providers, "Monitora chamadas gRPC", "Automatic hook")

' Infraestrutura -> Recursos Externos / Bancos
Rel(prisma_adapters, db_postgres, "Lê e grava dados", "SQL / Prisma Client (Port 5433)")
Rel(rabbitmq_publisher, rabbitmq, "Publica eventos", "AMQP (Port 5672)")
Rel(grpc_providers, ms_entregadores, "Chama RPCs", "gRPC (Port 5001)")
Rel(grpc_providers, ms_roteamento, "Chama RPCs", "gRPC (Port 5002)")
Rel(grpc_providers, ms_recomendacao, "Chama RPCs", "gRPC (Port 50053)")
Rel(redis_client, db_redis, "Consulta/Grava cache", "ioredis client (Port 6379)")

@enduml
