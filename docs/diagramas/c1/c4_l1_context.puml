@startuml C4_L1_System_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Contexto de Sistema (L1) - Express Delivery

' -------------------------------------------------------------
' ATORES / PESSOAS
' -------------------------------------------------------------
Person(cliente, "Cliente", "Utiliza o sistema para visualizar cardápios, realizar pedidos e acompanhar entregas em tempo real via interface Web.")
Person(entregador, "Entregador", "Utiliza o painel web dedicado para gerenciar disponibilidade, aceitar corridas e atualizar sua localização geográfica.")
Person(lojista, "Lojista (Restaurante)", "Gerencia cardápios, produtos, recebe pedidos e acompanha insights competitivos da loja via painel web.")

' -------------------------------------------------------------
' SISTEMA PRINCIPAL
' -------------------------------------------------------------
System(express_delivery, "Sistema Express Delivery", "Permite que clientes peçam comida de restaurantes parceiros, lojistas gerenciem seus negócios e entregadores controlem suas rotas com rastreamento logístico em tempo real.")

' -------------------------------------------------------------
' SISTEMAS EXTERNOS / DEPENDÊNCIAS
' -------------------------------------------------------------
System_Ext(osrm_server, "Servidor de Roteamento (OSRM)", "Resolve caminhos geométricos, distâncias físicas e tempos de viagem ótimos com base nos mapas reais OpenStreetMap.")
System_Ext(stripe, "Gateway de Pagamento (Stripe)", "Processa transações de cartão de crédito e PIX, gerencia cobranças e estornos de forma segura.")
System_Ext(mailtrap, "Servidor de E-mail (Mailtrap)", "Dispara notificações eletrônicas de pedidos e status via API HTTP REST (ou SMTP) de forma resiliente.")

' -------------------------------------------------------------
' RELACIONAMENTOS
' -------------------------------------------------------------
Rel(cliente, express_delivery, "Visualiza cardápios, faz pedidos e acompanha entregas em tempo real", "HTTPS / JSON (GraphQL)")
Rel(entregador, express_delivery, "Gerencia disponibilidade, aceita corridas, atualiza localização e status", "HTTPS / JSON (GraphQL)")
Rel(lojista, express_delivery, "Gerencia estabelecimentos, cardápios e visualiza insights competitivos", "HTTPS / JSON (GraphQL)")
Rel(express_delivery, osrm_server, "Consulta rotas ideais e estimativas de trajeto", "HTTP / JSON")
Rel(express_delivery, stripe, "Processa cobranças e pagamentos de pedidos", "HTTPS / REST API")
Rel(express_delivery, mailtrap, "Dispara e-mails transacionais de notificação", "HTTPS / REST API")

@enduml
