@startuml C4_L2_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Containers (L2) - Express Delivery

' -------------------------------------------------------------
' ATORES / PESSOAS
' -------------------------------------------------------------
Person(cliente, "Cliente", "Utiliza o sistema para visualizar cardápios, realizar pedidos e acompanhar entregas em tempo real.")
Person(entregador, "Entregador", "Utiliza o sistema para gerenciar disponibilidade, aceitar corridas e atualizar sua localização geográfica.")
Person(lojista, "Lojista (Restaurante)", "Gerencia cardápios, produtos, recebe pedidos e acompanha insights competitivos da loja.")

' Frontend Container (Executado no dispositivo do cliente)
Container(frontend, "Frontend Web", "React + Vite, TailwindCSS", "Interface Web SPA unificada que fornece as telas para Clientes, Lojistas e o App do Entregador.")

' -------------------------------------------------------------
' REDE PRIVADA / BACKEND
' -------------------------------------------------------------
System_Boundary(private_backend, "Rede Privada / Servidores de Backend") {
    
    ' API Gateway Container
    Container(gateway, "API Gateway (Kong)", "Kong 3.4 DB-less", "Valida assinatura e expiração do JWT, CORS, Rate Limiting, correlation-id e roteamento de borda na porta 8000.")

    ' Core Backend Container (GraphQL API)
    Container(api_node, "Backend Core (API Node)", "TypeScript, Node.js, GraphQL, Prisma", "Orquestrador principal. Provê a API GraphQL, gerencia autenticação, usuários, restaurantes, pedidos, cancelamento de simulações e integrações gRPC.")

    ' Microserviço de Entregadores (.NET 10)
    Container(ms_entregadores, "Microserviço de Entregadores", "C#, .NET 10, gRPC", "Gerencia o ciclo de vida, disponibilidade, bloqueio de simulação e o rastreamento em tempo real da frota no Redis.")

    ' Microserviço de Roteamento (.NET 10)
    Container(ms_roteamento, "Microserviço de Roteamento", "C#, .NET 10, gRPC", "Responsável pelo cálculo de rotas ideais, estimativas de tempos e trajetos de coleta/entrega usando OSRM.")

    ' Microserviço de Recomendação (Python)
    Container(ms_recomendacao, "Microserviço de Recomendação", "Python, FastAPI, gRPC, SQLAlchemy", "Gera insights analíticos de preços para lojistas baseados em geolocalização e histórico de vendas locais.")

    ' Microserviço de Notificações (Python)
    Container(ms_notificacoes, "Microserviço de Notificações", "Python, pika, urllib", "Consome eventos e envia notificações por e-mail em background via HTTP REST ou SMTP tradicional.")

    ' Armazenamento de Dados Relacional - Core
    ContainerDb(db_postgres, "Banco de Dados Principal", "PostgreSQL 15", "Armazena dados transacionais de usuários, restaurantes, produtos, pedidos, pagamentos e avaliações.")

    ' Armazenamento de Dados Relacional - Entregadores
    ContainerDb(db_entregadores, "Banco de Dados Entregadores", "PostgreSQL 15", "Armazena dados isolados dos entregadores cadastrados no sistema.")

    ' Armazenamento de Dados Relacional - Recomendação
    ContainerDb(db_recomendacao, "Banco de Dados Recomendação", "PostgreSQL 15", "Armazena o histórico analítico de vendas e as réplicas locais de dados para geoprocessamento.")

    ' Armazenamento Cache e In-Memory (Redis)
    ContainerDb(db_redis, "Cache e Posições (Redis)", "Redis 7", "Armazena posições geográficas em tempo real dos entregadores (Redis Geo) e serve como cache-aside de queries GraphQL frequentes.")

    ' Mensageria e Eventos de Negócio (RabbitMQ)
    Container(rabbitmq, "RabbitMQ Message Broker", "RabbitMQ 3", "Roteia eventos assíncronos (pedido.confirmado, pagamento.aprovado, entrega.atribuida) entre serviços.")

    ' Replicação de catálogo por eventos de domínio
    Container(catalogo_eventos, "Replicação de Catálogo por Eventos", "RabbitMQ topic exchange", "O api-node publica eventos de domínio de restaurante, categoria e produto; o ms-recomendacao os aplica nas suas réplicas locais.")
}

' -------------------------------------------------------------
' SISTEMAS EXTERNOS / DEPENDÊNCIAS
' -------------------------------------------------------------
System_Boundary(externals, "Serviços Externos") {
    Container(osrm_server, "Servidor de Roteamento (OSRM)", "C++ (OSRM Backend)", "Servidor OSRM que resolve caminhos geométricos e estimativas físicas reais.")
    System_Ext(stripe, "Gateway de Pagamento (Stripe)", "Processa transações financeiras de forma segura.")
    System_Ext(mailtrap, "Servidor de E-mail (Mailtrap)", "Plataforma para teste de emails via API HTTP REST ou SMTP.")
}

' Telemetria e Monitoramento
System_Boundary(observability, "Observabilidade") {
    Container(jaeger, "Jaeger Tracing", "Jaeger All-in-One", "Centraliza a visualização de traces distribuídos gRPC/GraphQL.")
    Container(prometheus, "Prometheus Metrics", "Prometheus Server", "Coleta métricas temporais das aplicações instrumentadas.")
    Container(grafana, "Grafana Dashboards", "Grafana OSS", "Visualiza painéis analíticos e métricas consolidadas do sistema.")
}

' -------------------------------------------------------------
' RELACIONAMENTOS / FLUXOS DE COMUNICAÇÃO
' -------------------------------------------------------------

' Usuários
Rel(cliente, frontend, "Interage com a interface", "HTTPS / SPA")
Rel(lojista, frontend, "Acessa o painel do restaurante", "HTTPS / SPA")
Rel(entregador, frontend, "Gerencia entregas e localização no painel", "HTTPS / SPA")

Rel(frontend, gateway, "Envia requisições GraphQL", "HTTPS / JSON (Port 8000)")

' Gateway e API Core
Rel(gateway, api_node, "Encaminha requisições GraphQL", "HTTP / GraphQL (Port 4000)")
Rel(api_node, db_postgres, "Grava/lê dados transacionais", "Prisma Client (Port 5433)")
Rel(api_node, db_redis, "Lê/grava cache-aside de queries", "TCP / ioredis (Port 6379)")
Rel(api_node, ms_entregadores, "Consulta entregadores próximos", "gRPC Client (Port 5001)")
Rel(api_node, ms_roteamento, "Solicita cálculo de rota", "gRPC Client (Port 5002)")
Rel(api_node, ms_recomendacao, "Busca insights e atualiza assinatura", "gRPC Client (Port 50053)")
Rel(api_node, rabbitmq, "Publica eventos (pedido.confirmado, pagamento.aprovado)", "AMQP / amqplib (Port 5672)")
Rel(api_node, stripe, "Solicita cobrança de cartões/Pix", "HTTPS / REST API")

' Microsserviços
Rel(ms_entregadores, db_entregadores, "Persiste entregadores", "ADO.NET / EF Core (Port 5434)")
Rel(ms_entregadores, db_redis, "Salva posições geográficas em tempo real", "Redis Geo Commands (Port 6379)")
Rel(ms_entregadores, rabbitmq, "Publica entrega.atribuida / Consome pedido.confirmado", "AMQP / TCP (Port 5672)")

Rel(ms_roteamento, osrm_server, "Consulta estimativas e trajetos físicos", "HTTP / JSON (Port 5080)")

Rel(ms_recomendacao, db_recomendacao, "Grava histórico analítico e réplicas", "SQLAlchemy (Port 5436)")
Rel(ms_recomendacao, rabbitmq, "Consome pedido.confirmado", "AMQP / TCP (Port 5672)")

Rel(ms_notificacoes, rabbitmq, "Consome eventos para disparar e-mails", "AMQP / TCP (Port 5672)")
Rel(ms_notificacoes, mailtrap, "Dispara e-mails transacionais", "HTTPS / REST (Port 443) ou SMTP (Port 2525)")

' CDC e Replicação
Rel(api_node, catalogo_eventos, "Publica eventos de catálogo", "AMQP (restaurante./categoria./produto.*)")
Rel(catalogo_eventos, ms_recomendacao, "Entrega na fila recomendacao.catalog", "AMQP (Port 5672)")

' Traces e Métricas
Rel(api_node, jaeger, "Envia traces distribuídos", "OTLP / gRPC (Port 4317)")
Rel(ms_entregadores, jaeger, "Envia traces distribuídos", "OTLP / gRPC (Port 4317)")
Rel(ms_roteamento, jaeger, "Envia traces distribuídos", "OTLP / gRPC (Port 4317)")
Rel(ms_recomendacao, jaeger, "Envia traces distribuídos", "OTLP / gRPC (Port 4317)")
Rel(ms_notificacoes, jaeger, "Envia traces distribuídos", "OTLP / HTTP (Port 4318)")
Rel(prometheus, api_node, "Scrape de métricas", "HTTP / Prometheus format")
Rel(grafana, prometheus, "Consulta métricas temporais", "HTTP / REST API")
Rel(grafana, jaeger, "Busca traces vinculados", "HTTP / REST API")

@enduml
