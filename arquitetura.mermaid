graph TD
    %% ─────────────────────────────────────────────
    %% Styling
    %% ─────────────────────────────────────────────
    classDef person   fill:#08427b,stroke:#052e56,stroke-width:2px,color:#fff;
    classDef frontend fill:#1a5276,stroke:#2e86c1,stroke-width:2px,color:#fff;
    classDef gw       fill:#4b2c63,stroke:#9d4edd,stroke-width:2px,color:#fff;
    classDef core     fill:#0e5f4e,stroke:#1abc9c,stroke-width:2px,color:#fff;
    classDef ms       fill:#1d2d44,stroke:#3e885b,stroke-width:2px,color:#fff;
    classDef db       fill:#0b132b,stroke:#00b4d8,stroke-width:2px,color:#fff;
    classDef cache    fill:#6e1a1a,stroke:#e74c3c,stroke-width:2px,color:#fff;
    classDef broker   fill:#2d1a12,stroke:#f8961e,stroke-width:2px,color:#fff;
    classDef obs      fill:#1c2833,stroke:#f1c40f,stroke-width:2px,color:#fff;
    classDef ext      fill:#121212,stroke:#666,stroke-width:1px,color:#aaa;

    %% ─────────────────────────────────────────────
    %% Atores / Usuários
    %% ─────────────────────────────────────────────
    Cliente["👤 Cliente<br>(faz pedidos, rastreia entregas)"]:::person
    Entregador["🏍️ Entregador<br>(aceita corridas, atualiza localização)"]:::person
    Lojista["🏪 Lojista / Restaurante<br>(gerencia cardápio, vê insights B2B)"]:::person

    %% ─────────────────────────────────────────────
    %% Camada de Entrada
    %% ─────────────────────────────────────────────
    Frontend["Frontend Web — :5173<br>(React SPA + Leaflet Maps)"]:::frontend
    Kong["Kong API Gateway — :8000<br>(JWT Auth · Rate Limit · Proxy)"]:::gw

    %% ─────────────────────────────────────────────
    %% Backend Core
    %% ─────────────────────────────────────────────
    API["API Node — :4000<br>(Node.js · TypeScript · Apollo Server GraphQL)<br>Clean Architecture: Presentation → Application → Domain → Infrastructure<br>Prisma ORM · Strategy Pattern (Pagamentos)"]:::core

    %% ─────────────────────────────────────────────
    %% Microserviços
    %% ─────────────────────────────────────────────
    subgraph MS ["Microserviços"]
        direction LR
        MS_Entregadores["MS Entregadores — :5001<br>(C# · .NET 10 · gRPC · EF Core)<br>Gestão de disponibilidade<br>Atribuição de entregas · Redis Geo"]:::ms
        MS_Roteamento["MS Roteamento — :5002<br>(C# · .NET 10 · gRPC)<br>Cálculo de rotas e trajetos<br>Consome OSRM Engine"]:::ms
        MS_Recomendacao["MS Recomendação — :50053<br>(Python · FastAPI · gRPC)<br>Motor de precificação B2B<br>Réplica analítica via CDC"]:::ms
        MS_Notificacoes["MS Notificações<br>(Python · Pika)<br>Envio resiliente de e-mails<br>HTTP REST / SMTP Fallback"]:::ms
    end

    %% ─────────────────────────────────────────────
    %% Mensageria
    %% ─────────────────────────────────────────────
    subgraph MESSAGING ["Mensageria — trabalho (RabbitMQ) e replicação (Kafka)"]
        direction TB
        RabbitMQ["RabbitMQ Broker<br>(Exchange topic: delivery-events)<br>Filas: entregas.pedido-confirmado<br>api.entrega-atribuida · notificacoes.eventos"]:::broker
        DLX["Dead Letter Exchange<br>(delivery-events.dlx)<br>Uma DLQ por fila, isolada por routing key"]:::broker
        Debezium["Debezium Connect 2.4<br>(Logical decoding do WAL)"]:::broker
        Kafka["Apache Kafka — modo KRaft<br>Tópicos: dbserver1.public.*"]:::broker
    end

    %% ─────────────────────────────────────────────
    %% Persistência
    %% ─────────────────────────────────────────────
    subgraph PERSISTENCE ["Persistência"]
        direction LR
        DB_Main[("PostgreSQL Principal — :5435<br>(delivery_db)<br>wal_level=logical · índices em todas as FKs")]:::db
        DB_Entregadores[("PostgreSQL Entregadores — :5434<br>(entregadores_db)<br>Isolado por domínio")]:::db
        DB_Recomendacao[("PostgreSQL Recomendação — :5436<br>(recomendacao_db)<br>Réplica analítica via CDC")]:::db
        Redis[("Redis — :6380<br>Cache-aside · Redis Geo<br>Localização em tempo real")]:::cache
    end

    %% ─────────────────────────────────────────────
    %% Observabilidade
    %% ─────────────────────────────────────────────
    subgraph OBS ["Observabilidade (OpenTelemetry)"]
        direction LR
        Jaeger["Jaeger — :16686<br>(Distributed Tracing)<br>Recebe traces OTLP :4317"]:::obs
        Prometheus["Prometheus — :9090<br>(Coleta de Métricas)"]:::obs
        Grafana["Grafana — :3000<br>(Dashboards consolidados)"]:::obs
    end

    %% ─────────────────────────────────────────────
    %% Integrações Externas
    %% ─────────────────────────────────────────────
    OSRM["OSRM Engine — :5080<br>(OpenStreetMap · C++ Engine)<br>Roteamento geográfico real"]:::ext
    Stripe["Stripe API<br>(Pagamentos · Cartão / Pix)"]:::ext
    Mailtrap["Mailtrap SMTP / HTTP REST<br>(Simulação e envio real de e-mails)"]:::ext

    %% ─────────────────────────────────────────────
    %% Fluxo Principal: Usuários → Frontend → Kong → API
    %% ─────────────────────────────────────────────
    Cliente    -- "HTTP / Browser" --> Frontend
    Entregador -- "HTTP / Browser" --> Frontend
    Lojista    -- "HTTP / Browser" --> Frontend

    Frontend -- "HTTP / GraphQL requests" --> Kong
    Kong     -- "GraphQL proxy"           --> API

    %% ─────────────────────────────────────────────
    %% API → Microserviços (gRPC)
    %% ─────────────────────────────────────────────
    API -- "gRPC (GerenciarEntregadores,<br>AtribuirEntrega)" --> MS_Entregadores
    API -- "gRPC (CalcularRota,<br>ObterTrajeto)"            --> MS_Roteamento
    API -- "gRPC (ObterInsightsLoja)"                        --> MS_Recomendacao

    %% ─────────────────────────────────────────────
    %% API → Persistência e Mensageria
    %% ─────────────────────────────────────────────
    API -- "ORM Prisma (SQL)"    --> DB_Main
    API -- "Cache-aside / GET"   --> Redis
    API -- "Publish (AMQP)<br>pedidos.confirmado" --> RabbitMQ
    API -- "Transações financeiras (HTTPS)" --> Stripe

    %% ─────────────────────────────────────────────
    %% Fluxo de Mensageria Assíncrona (RabbitMQ)
    %% ─────────────────────────────────────────────
    RabbitMQ -- "Queue: pedidos.confirmado"  --> MS_Entregadores
    RabbitMQ -- "Queue: notificacoes.eventos"--> MS_Notificacoes
    MS_Entregadores -- "Publish: entrega.atribuida (AMQP)" --> RabbitMQ
    RabbitMQ -- "Queue: api.entrega-atribuida" --> API

    %% ─────────────────────────────────────────────
    %% MS Entregadores → Persistência
    %% ─────────────────────────────────────────────
    MS_Entregadores -- "EF Core (SQL)" --> DB_Entregadores
    MS_Entregadores -- "Redis Geo (localização)" --> Redis

    %% ─────────────────────────────────────────────
    %% MS Roteamento → OSRM
    %% ─────────────────────────────────────────────
    MS_Roteamento -- "HTTP REST" --> OSRM

    %% ─────────────────────────────────────────────
    %% Change Data Capture: replicação derivada do WAL
    %% ─────────────────────────────────────────────
    DB_Main         -- "Replication slot (WAL)"     --> Debezium
    Debezium        -- "Publica mudanças"           --> Kafka
    Kafka           -- "Consumer group (earliest)"  --> MS_Recomendacao
    MS_Recomendacao -- "Persist replicas (SQL)"     --> DB_Recomendacao
    RabbitMQ        -. "Mensagem rejeitada (nack)" .-> DLX

    %% ─────────────────────────────────────────────
    %% MS Notificações → Mailtrap
    %% ─────────────────────────────────────────────
    MS_Notificacoes -- "HTTP REST / SMTP" --> Mailtrap

    %% ─────────────────────────────────────────────
    %% Observabilidade (OpenTelemetry → Jaeger)
    %% ─────────────────────────────────────────────
    API             -- "OTEL traces (gRPC :4317)" --> Jaeger
    MS_Entregadores -- "OTEL traces (gRPC :4317)" --> Jaeger
    MS_Roteamento   -- "OTEL traces (gRPC :4317)" --> Jaeger
    MS_Recomendacao -- "OTEL traces (gRPC :4317)" --> Jaeger

    Prometheus -- "Scrape metrics" --> API
    Prometheus -- "Scrape metrics" --> MS_Entregadores
    Grafana    -- "Query"          --> Prometheus
    Grafana    -- "Query traces"   --> Jaeger
